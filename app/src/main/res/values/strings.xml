    <!-- Autorisation d'accès aux fichiers -->
    <string name="permission_title">Accès aux fichiers</string>
    <string name="permission_explanation">XFiles a besoin de l\'autorisation « Accès à tous les fichiers » pour afficher et gérer vos fichiers. Le bouton ci-dessous ouvre la page de réglage d\'Android : activez l\'interrupteur, puis revenez dans XFiles avec le geste Retour.</string>
    <string name="permission_button">Ouvrir le réglage d\'accès aux fichiers</string>
    <string name="permission_not_granted">L\'accès n\'est pas encore accordé. Ouvrez à nouveau le réglage et activez l\'interrupteur.</string>
    <string name="permission_no_settings">Impossible d\'ouvrir le réglage sur ce téléphone. Accordez l\'accès dans Paramètres, Applications, XFiles, Autorisations.</string>

    <!-- Racine d'Explorer -->
    <string name="section_on_device">Sur l\'appareil</string>
    <string name="location_internal">Stockage interne</string>
    <string name="location_downloads">Téléchargements</string>
    <string name="location_documents">Documents</string>
