# Appliqué par patch.sh sur une copie du module officiel (le cache Go reste intact).
diff -ru a/backend/drive/drive.go b/backend/drive/drive.go
--- a/backend/drive/drive.go
+++ b/backend/drive/drive.go
@@ -88,6 +88,7 @@
 		ClientID:     rcloneClientID,
 		ClientSecret: obscure.MustReveal(rcloneEncryptedClientSecret),
 		RedirectURL:  oauthutil.RedirectURL,
+		UsePKCE:      true, // XFiles : PKCE (RFC 7636), le code intercepté sur le port local est inutilisable
 	}
